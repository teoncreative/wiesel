PROJECT_NAME = "Wiesel Engine"
PROJECT_BRIEF = "Cross-platform game engine with Vulkan, C# scripting, and a full editor"
OUTPUT_DIRECTORY = docs

# Input sources - engine C++ API, editor, and C# scripting API
INPUT = docs/mainpage.dox \
        wiesel/include \
        wiesel/src \
        editor/include \
        wiesel/assets/scripts

RECURSIVE = YES

# Process headers for C++, all .cs files for C# API, .dox for group/page definitions
FILE_PATTERNS = *.h *.cs *.dox

# Exclude third-party, internal libraries, build dirs, and meta files
EXCLUDE_PATTERNS = */vendor/* \
                   */libs/* \
                   */cmake-build-*/* \
                   */build/* \
                   */_deps/* \
                   *.meta

GENERATE_TREEVIEW = YES
DISABLE_INDEX = NO
FULL_SIDEBAR = NO
HTML_EXTRA_STYLESHEET = docs/styles/doxygen-awesome.css
FULL_PATH_NAMES = NO
EXTRACT_ALL = YES

# Enable grouping/modules
GROUP_GRAPHS = YES

# C# support
EXTENSION_MAPPING = cs=Csharp
OPTIMIZE_OUTPUT_JAVA = YES

# Use markdown for main page
USE_MDFILE_AS_MAINPAGE =

# Source browser
SOURCE_BROWSER = NO
VERBATIM_HEADERS = NO

# Inheritance and collaboration graphs
HAVE_DOT = NO

# Suppress build noise
QUIET = YES
WARNINGS = YES
WARN_IF_UNDOCUMENTED = NO